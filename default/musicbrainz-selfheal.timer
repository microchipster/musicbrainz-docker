[Unit]
Description=Run the MusicBrainz self-healing check every 30 minutes

[Timer]
# Use a wall-clock cadence rather than monotonic OnBootSec/OnUnitActiveSec:
# monotonic timers lose their schedule when the systemd user manager is
# restarted (e.g. after adding the user to the docker group), leaving the
# self-heal monitor silently dead.
OnCalendar=*:0/30
Persistent=true

[Install]
WantedBy=timers.target
